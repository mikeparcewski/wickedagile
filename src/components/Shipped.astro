---
/**
 * Shipped.astro — "experiments." · the family as a LAYERED PLATFORM STACK.
 *
 * NOT a loop. The seven packages are building blocks that COMPOSE UPWARD into a
 * solution: infrastructure at the foundation → tools → learning → the control
 * plane on top, which together make one operable, governed coding agent (the
 * capstone). wicked-interactive is a SURFACE beside the stack — a different
 * collaboration mode (real-time, creative), not a layer in the governed stack.
 *
 * Left column = the stack (capstone + four layers, foundation at the bottom).
 * Right column = the REUSED preview pane (browser-frame screenshot for the five
 * live sites; a faux code-card for the two no-site libs, brain + bus). Selecting
 * any block drives that pane (showSite / showLib) via data-idx + data-mode +
 * data-preview/data-lib + data-role/data-color — the same contract as before.
 *
 * AUTO-PLAY (shipped.js): the stack ASSEMBLES bottom-up — each block lights in
 * data-order (estate→bus→garden→testing→brain→crew), the built layers stay lit
 * (cumulative), then the capstone fires ("solution assembled"), a beat, and it
 * resets and rebuilds. Any click / focus / arrow-key hands control to the
 * visitor (all blocks snap to "built", the picked one active). Parks fully-built
 * under prefers-reduced-motion. Below ~880px it falls back to a stacked,
 * layer-labelled list (.shipped-mobile).
 *
 * NOTE: wicked-testing sits in the TOOLS layer with wicked-garden — it's a test
 * harness crew uses, not part of the control plane. estate + bus = infra;
 * garden + testing = tools; brain = learning; crew = control plane.
 */

// ── the SOLUTION capstone (the outcome, not a package — non-selectable) ──────
const solution = { label: 'an operable coding agent', sub: 'intent in · verified work out' };

// ── the STACK: four layers, TOP → BOTTOM (foundation renders last/lowest). ───
// Each block keeps its product's data-* preview contract (idx/mode/preview|lib/
// role/color) unchanged, plus data-order = the bottom-up assemble sequence.
const layers = [
  { key: 'control', label: 'Control plane', hue: '#d2a8ff', blocks: [
    { name: 'wicked-crew', role: 'Drive · gate · audit', order: 5, idx: 4, mode: 'site', preview: '4', color: '#d2a8ff', tint: '#e2c5ff', href: 'https://wc.wickedagile.com' },
  ]},
  { key: 'learning', label: 'Learning', hue: '#79c0ff', blocks: [
    { name: 'wicked-brain', role: 'Domain · decisions', order: 4, idx: 2, mode: 'lib', lib: 'wicked-brain', color: '#79c0ff', tint: '#a5d6ff', href: 'https://github.com/mikeparcewski/wicked-brain' },
  ]},
  { key: 'tools', label: 'Tools', hue: '#ffda19', blocks: [
    { name: 'wicked-garden',  role: 'Steer · rigor',   order: 2, idx: 0, mode: 'site', preview: '1', color: '#ffda19', tint: '#ffe45c', href: 'https://wg.wickedagile.com' },
    { name: 'wicked-testing', role: 'Test harness',    order: 3, idx: 3, mode: 'site', preview: '3', color: '#56d364', tint: '#7ee787', href: 'https://wt.wickedagile.com' },
  ]},
  { key: 'infra', label: 'Infrastructure', hue: '#9aa7b3', blocks: [
    { name: 'wicked-estate', role: 'Code graph',   order: 0, idx: 1, mode: 'site', preview: '2', color: '#79c0ff', tint: '#a5d6ff', href: 'https://we.wickedagile.com' },
    { name: 'wicked-bus',    role: 'Event fabric', order: 1, idx: 5, mode: 'lib', lib: 'wicked-bus', color: '#9aa7b3', tint: '#b6c2ce', href: 'https://github.com/mikeparcewski/wicked-bus' },
  ]},
];

// wicked-interactive — a SURFACE beside the stack (different collaboration mode).
const surface = {
  key: 'wicked-interactive', role: 'Surface', color: '#f0a868',
  idx: 6, mode: 'site', preview: '0', href: 'https://wi.wickedagile.com',
};

// ── MOBILE fallback data (article-style): the seven packages, layer-grouped. ──
const packages = [
  { name: 'wicked-crew', role: 'Control plane', color: '#d2a8ff', lang: 'JS', site: 'wc.wickedagile.com', href: 'https://wc.wickedagile.com', shot: '/screenshots/wicked-crew.png', desc: 'The control room for governed agent delivery — drive, gate, audit; the human stays in command. The harness for your agent harnesses.' },
  { name: 'wicked-brain', role: 'Learning', color: '#79c0ff', lang: 'JS', href: 'https://github.com/mikeparcewski/wicked-brain', desc: 'The learning layer — captures domain, requirements, decisions and learnings with provenance; search, challenge, correct, trace to source. What learns into estate, distinct from its code graph.' },
  { name: 'wicked-garden', role: 'Tools', color: '#ffda19', lang: 'JS', site: 'wg.wickedagile.com', href: 'https://wg.wickedagile.com', shot: '/screenshots/wicked-garden.png', desc: "Steering before execution — reads each prompt's work-shape + risk and applies the right rigor, plus the capabilities a planner-executor can't do alone." },
  { name: 'wicked-testing', role: 'Tools', color: '#56d364', lang: 'JS', site: 'wt.wickedagile.com', href: 'https://wt.wickedagile.com', shot: '/screenshots/wicked-testing.png', desc: 'A test harness crew uses — no agent grades its own homework: an enforced wall between the agent that runs the tests and the one that judges them.' },
  { name: 'wicked-estate', role: 'Infrastructure', color: '#79c0ff', lang: 'RS', site: 'we.wickedagile.com', href: 'https://we.wickedagile.com', shot: '/screenshots/wicked-estate.png', desc: 'Your live technical environment, queryable — requirements↔implementation, blast-radius, infra + policy relationships, operational history.' },
  { name: 'wicked-bus', role: 'Infrastructure', color: '#9aa7b3', lang: 'JS', href: 'https://github.com/mikeparcewski/wicked-bus', desc: 'The durable nervous system beneath it all — local-first, at-least-once, replayable. The fabric the whole stack rides on.' },
  { name: 'wicked-interactive', role: 'Surface', color: '#f0a868', lang: 'JS', site: 'wi.wickedagile.com', href: 'https://wi.wickedagile.com', shot: '/screenshots/wicked-interactive.png', desc: "A surface beside — composes the family's building blocks into HTML/PDF/decks. Describe it, watch it build, point to refine." },
];
const crewPkg = packages.find((p) => p.name === 'wicked-crew');
const restPkgs = packages.filter((p) => p.name !== 'wicked-crew');
---

<!-- ════════════════════════════════════════════════════════════════
     SHIPPED — "experiments." · a LAYERED PLATFORM STACK (not a loop).
     Building blocks compose UPWARD — infra → tools → learning → control plane
     → one operable coding agent (the capstone). interactive is a surface beside.
     ════════════════════════════════════════════════════════════════ -->
<section class="zoneB-section snap-section" id="projects">
  <div class="build-shell">
    <!-- compact header -->
    <div class="orbit-head">
      <span class="zone-kicker">WORKSPACE · 7 PACKAGES · 5 DEPLOYED · ONE STACK</span>
      <h2 class="zone-title">experiments.</h2>
      <p class="orbit-caption">Not a loop — <b>building blocks</b>. Local-first pieces that compose upward, infrastructure to control plane, into one operable coding agent.</p>
    </div>

    <div class="build-grid">
      <!-- ── LEFT: the layered stack ─────────────────────────────────── -->
      <div class="stack-col">
        <div class="stack" id="stackRoot" role="group"
             aria-label="The wicked platform stack: infrastructure (wicked-estate, wicked-bus) at the foundation, then tools (wicked-garden, wicked-testing), learning (wicked-brain), and the control plane (wicked-crew) on top — composing into one operable coding agent.">

          <!-- the rising "energy" pulse (travels the spine, driven by shipped.js) -->
          <span class="spine-pulse" id="spinePulse" aria-hidden="true"></span>

          <!-- capstone: the SOLUTION (outcome, not a package) -->
          <div class="solution-cap" id="solutionCap">
            <span class="cap-mark" aria-hidden="true">= </span>
            <span class="cap-text">
              <span class="cap-label">{solution.label}</span>
              <span class="cap-sub">{solution.sub}</span>
            </span>
          </div>
          <div class="stack-riser" aria-hidden="true"><span class="riser-arrow">▲</span><span class="riser-word">composes into</span></div>

          <!-- the four layers, top → bottom (foundation lowest) -->
          {layers.map((layer) => (
            <div class:list={["layer", `layer--${layer.key}`]} style={`--hue:${layer.hue}`}>
              <span class="layer-label">{layer.label}</span>
              <div class="layer-blocks">
                {layer.blocks.map((b) => (
                  <a
                    class="block"
                    href={b.href}
                    target={b.mode === 'site' ? '_self' : '_blank'}
                    rel="noopener"
                    style={`--role:${b.color};--role-tint:${b.tint}`}
                    data-idx={b.idx}
                    data-mode={b.mode}
                    data-preview={b.preview}
                    data-lib={b.mode === 'lib' ? b.lib : undefined}
                    data-role={b.role}
                    data-color={b.color}
                    data-order={b.order}
                    aria-label={`${b.name} — ${b.role}`}
                  >
                    <span class="blk-dot" aria-hidden="true"></span>
                    <span class="blk-name">{b.name}</span>
                    <span class="blk-role">{b.role}</span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>

        <!-- wicked-interactive — a surface BESIDE the stack (creative mode). -->
        <a class="surface-strip" href={surface.href} target="_self" rel="noopener"
           data-idx={surface.idx} data-mode={surface.mode} data-preview={surface.preview}
           data-role={surface.role} data-color={surface.color}
           aria-label="wicked-interactive — a surface beside the stack: describe it, watch it build, point to refine (click to preview)">
          <span class="ss-dot" aria-hidden="true"></span>
          <span class="ss-label"><b>wicked-interactive</b> <span class="ss-sep" aria-hidden="true">·</span> a surface beside — describe it, watch it build, point to refine</span>
          <span class="ss-tag">try it ↗</span>
        </a>

        <p class="stack-hint">The spine carries the energy up · click any block to preview it</p>
      </div>

      <!-- ── RIGHT: the REUSED preview pane ───────────────────────────── -->
      <div class="preview-col" id="workspacePane">
        <div class="ide-preview" id="idePreview" data-mode="site">
          <div class="center-titlebar">
            <span class="ct-name" id="crumbName">wicked-estate</span>
            <span class="ct-role" id="centerRole" style="color:#79c0ff">Code graph</span>
          </div>

          <div class="preview-stage" id="previewPanel">
            <!-- MODE (a): SITE — browser-frame (shown at init; estate = foundation) -->
            <div class="browser-frame" id="browserFrame">
              <div class="browser-chrome">
                <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="url" id="previewUrl">we.wickedagile.com</span>
                <span class="live"><span class="pulse" aria-hidden="true"></span>Live</span>
              </div>
              <div class="browser-shot" id="browserShot">
                <div class="shot-bg shot-bg-back"></div>
                <div class="shot-bg shot-bg-front" style="background-image:url('/screenshots/wicked-estate.png')"></div>
              </div>
            </div>

            <!-- MODE (b): LIBRARY — faux code-editor card (hidden at init) -->
            <div class="code-card" id="codeCard" aria-hidden="true" hidden>
              <div class="code-card-chrome">
                <span class="cc-glyph" aria-hidden="true">JS</span>
                <span class="cc-file" id="codeFile">wicked-bus.js</span>
                <span class="cc-badge">read-only</span>
              </div>
              <div class="code-card-body">
                <pre class="code-block" id="codeBlock"><code></code></pre>
              </div>
            </div>
          </div>

          <div class="preview-readout">
            <div class="readout-desc" id="readoutDesc">Your live technical environment, queryable — requirements↔implementation, blast-radius, infra + policy relationships, operational history.</div>
            <a class="readout-cta" id="readoutCta" href="https://we.wickedagile.com">Open ↗</a>
          </div>
        </div>
      </div>
    </div>{/* .build-grid */}

    <!-- MOBILE (≤880): the flagship, then the rest as a layer-labelled list. -->
    <div class="shipped-mobile" aria-label="the wicked family — the flagship and the building blocks it composes">
      <a class="expm-feat" href={crewPkg.href} target="_self" rel="noopener" style={`--role:${crewPkg.color}`}>
        <div class="expm-feat-shot" style={crewPkg.shot ? `background-image:url('${crewPkg.shot}')` : ''}>
          <span class="expm-feat-tag">Control plane · the flagship</span>
        </div>
        <div class="expm-feat-body">
          <h3 class="expm-feat-name">wicked-crew</h3>
          <p class="expm-feat-desc">{crewPkg.desc}</p>
          {crewPkg.site && (<span class="expm-feat-cta">{crewPkg.site} ↗</span>)}
        </div>
      </a>

      {restPkgs.map((p) => (
        <a class={`expm-row${p.shot ? ' has-shot' : ' is-repo'}`} href={p.href} target={p.shot ? '_self' : '_blank'} rel="noopener" style={`--role:${p.color}`}>
          {p.shot
            ? (<span class="expm-thumb" style={`background-image:url('${p.shot}')`}></span>)
            : (<span class="expm-thumb expm-thumb--icon"><span class="expm-glyph">{p.lang}</span></span>)}
          <span class="expm-body">
            <span class="expm-title"><b>{p.name}</b><span class="expm-role">{p.role}</span></span>
            <span class="expm-desc">{p.desc}</span>
          </span>
          <span class="expm-badge">{p.site ? 'live ↗' : 'repo ↗'}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style is:global>
/* ══════════════════════════════════════════════════════════════════
   SHIPPED — THE LAYERED STACK (building blocks → a solution)
   Reuses the hero editor conceit: #0d0f12 preview pane, 12px radius, deep
   shadow, var(--font-mono), the family role-colors. Theme-aware ground
   (tokens); the preview pane stays dark in both themes (matches the hero
   terminal). Left = the composing stack, right = the live preview.
   ══════════════════════════════════════════════════════════════════ */

.zoneB-section{
  border-top:1px solid var(--hairline);
  min-height:100svh;
  scroll-margin-top:var(--topbar-h);
  display:flex;flex-direction:column;justify-content:center;align-items:center;
  padding:18px 24px 14px;
  overflow:hidden; /* the stack is tuned to fit one viewport, never scroll */
}
.build-shell{
  width:100%;max-width:1320px;margin:0 auto;
  display:flex;flex-direction:column;align-items:center;
  gap:clamp(6px,1.6vh,18px)
}

/* ── COMPACT HEADER ────────────────────────────────────────────── */
.orbit-head{display:flex;flex-direction:column;align-items:center;gap:clamp(3px,.8vh,8px);text-align:center}
.orbit-head .zone-kicker{justify-content:center}
.orbit-head .zone-kicker::before,
.orbit-head .zone-kicker::after{content:'';width:18px;height:1px;background:var(--hairline-strong)}
.zone-title{
  font-family:var(--font-display);font-weight:900;font-stretch:125%;
  font-size:clamp(1.9rem,3.2vw,2.9rem);color:var(--ink);
  line-height:.9;letter-spacing:-.03em;margin:0
}
.orbit-caption{
  font-family:var(--font-sans,inherit);font-size:clamp(.8rem,1.1vw,.94rem);
  line-height:1.4;color:var(--muted);margin:0;max-width:64ch
}
.orbit-caption b{color:var(--ink);font-weight:700}

/* ── TWO-COLUMN: stack (left) + live preview (right) ───────────────── */
.build-grid{
  width:100%;display:grid;
  grid-template-columns:minmax(0,0.92fr) minmax(0,1.08fr);
  gap:clamp(16px,2.6vw,44px);align-items:center
}
.stack-col{display:flex;flex-direction:column;gap:clamp(8px,1.1vh,14px);min-width:0}

/* ── THE STACK ─────────────────────────────────────────────────── */
.stack{
  position:relative;display:flex;flex-direction:column;gap:clamp(5px,.8vh,9px);
  padding-left:26px /* rail gutter: energy rises up the spine into the capstone */
}
/* the spine rail (energy travels UP it, foundation → capstone) */
.stack::before{
  content:'';position:absolute;left:11px;top:10px;bottom:10px;width:2px;z-index:0;
  background:linear-gradient(to top,color-mix(in oklab,#9aa7b3 42%,transparent),color-mix(in oklab,var(--accent) 60%,transparent));
  opacity:.32;border-radius:2px
}
/* the travelling energy pulse — JS animates its `top`; hidden at rest */
.spine-pulse{
  position:absolute;left:11px;top:0;transform:translate(-50%,-50%);z-index:2;
  width:12px;height:12px;border-radius:50%;pointer-events:none;opacity:0;
  background:radial-gradient(circle,#fff,var(--accent) 42%,color-mix(in oklab,var(--accent) 45%,transparent) 66%,transparent 76%);
  box-shadow:0 0 16px 4px color-mix(in oklab,var(--accent) 55%,transparent),0 0 34px 8px color-mix(in oklab,var(--accent) 22%,transparent)
}

/* capstone — the solution (filled accent; the culmination, not a package) */
.solution-cap{
  position:relative;z-index:1;display:flex;align-items:center;gap:10px;
  padding:11px 16px;border-radius:12px;
  border:1px solid color-mix(in oklab,var(--accent) 55%,var(--hairline));
  background:linear-gradient(color-mix(in oklab,var(--accent) 16%,transparent),color-mix(in oklab,var(--accent) 5%,transparent));
  box-shadow:0 0 0 1px color-mix(in oklab,var(--accent) 14%,transparent),0 14px 40px -22px rgba(0,0,0,.7);
  transition:box-shadow .4s var(--ease),border-color .4s var(--ease),background .4s var(--ease)
}
.solution-cap .cap-mark{font-family:var(--font-mono);font-weight:900;font-size:1.05rem;color:var(--accent);flex-shrink:0;line-height:1}
.solution-cap .cap-text{display:flex;flex-direction:column;gap:1px;min-width:0}
.solution-cap .cap-label{font-family:var(--font-mono);font-size:.9rem;font-weight:700;color:var(--ink);letter-spacing:.01em}
.solution-cap .cap-sub{font-family:var(--font-mono);font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
/* fires when the stack finishes assembling (auto-play) or on any interaction */
.solution-cap.is-built{
  border-color:var(--accent);
  background:linear-gradient(color-mix(in oklab,var(--accent) 26%,transparent),color-mix(in oklab,var(--accent) 9%,transparent));
  box-shadow:0 0 0 1px color-mix(in oklab,var(--accent) 42%,transparent),0 0 46px -10px var(--accent),0 14px 40px -22px rgba(0,0,0,.7)
}

/* the upward-composition connector under the capstone */
.stack-riser{
  position:relative;z-index:1;display:flex;align-items:center;gap:8px;
  padding-left:6px;margin:-1px 0 1px;
  font-family:var(--font-mono);font-size:.52rem;letter-spacing:.16em;text-transform:uppercase;color:var(--faint)
}
.stack-riser .riser-arrow{color:color-mix(in oklab,var(--accent) 70%,var(--faint));font-size:.7rem;line-height:1}

/* ── LAYERS ────────────────────────────────────────────────────── */
.layer{
  position:relative;z-index:1;
  display:grid;grid-template-columns:88px 1fr;align-items:center;gap:12px;
  padding:8px 12px 8px 10px;border-radius:11px;
  border:1px solid var(--hairline);
  border-left:2px solid color-mix(in oklab,var(--hue) 60%,var(--hairline));
  background:linear-gradient(color-mix(in oklab,var(--hue) 5%,transparent),transparent 78%);
  transition:box-shadow .5s var(--ease),border-color .5s var(--ease),background .5s var(--ease)
}
/* the rising pulse "energizes" each layer as it passes (brief, then fades) */
.layer.is-pinged{
  border-left-color:color-mix(in oklab,var(--hue) 92%,#fff);
  background:linear-gradient(color-mix(in oklab,var(--hue) 13%,transparent),transparent 82%);
  box-shadow:-8px 0 26px -12px var(--hue),0 0 0 1px color-mix(in oklab,var(--hue) 28%,transparent)
}
.layer-label{
  font-family:var(--font-mono);font-size:.55rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;
  color:color-mix(in oklab,var(--hue) 62%,var(--muted));line-height:1.25
}
.layer-blocks{display:flex;flex-wrap:wrap;gap:8px;min-width:0}

/* a BLOCK = one package (selectable → drives the preview) */
.block{
  display:inline-flex;align-items:center;gap:8px;
  padding:7px 13px 7px 10px;border-radius:9px;text-decoration:none;
  background:linear-gradient(#14181d,#0f1216);
  border:1px solid var(--hairline-strong);
  box-shadow:0 6px 18px rgba(0,0,0,.42);
  font-family:var(--font-mono);white-space:nowrap;cursor:pointer;
  transition:transform .16s var(--ease),border-color .16s var(--ease),box-shadow .22s var(--ease),background .16s,opacity .3s
}
.block .blk-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0;background:var(--role);box-shadow:0 0 8px -1px var(--role)}
.block .blk-name{font-size:.8rem;font-weight:700;color:var(--role-tint);letter-spacing:.01em}
.block .blk-role{
  font-size:.52rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);
  padding-left:8px;border-left:1px solid var(--hairline-strong)
}
.block:hover,
.block:focus-visible{
  transform:translateY(-2px);
  border-color:color-mix(in oklab,var(--role) 55%,transparent);
  box-shadow:0 10px 26px rgba(0,0,0,.5),0 0 0 1px color-mix(in oklab,var(--role) 32%,transparent),0 0 26px -8px var(--role);
  outline:none
}
.block:focus-visible{box-shadow:0 10px 26px rgba(0,0,0,.5),0 0 0 2px var(--role),0 0 26px -6px var(--role)}
.block[aria-current="true"]{
  border-color:var(--role);background:linear-gradient(#191d23,#111418);
  box-shadow:0 10px 30px rgba(0,0,0,.55),0 0 0 1px color-mix(in oklab,var(--role) 55%,transparent),0 0 34px -6px var(--role)
}
.block[aria-current="true"] .blk-dot{box-shadow:0 0 14px 0 var(--role)}
.block[aria-current="true"] .blk-role{color:var(--role-tint)}

/* ── wicked-interactive — a surface BESIDE the stack ───────────────── */
.surface-strip{
  display:flex;align-items:center;gap:10px;width:100%;
  font-family:var(--font-mono);font-size:.62rem;text-decoration:none;color:var(--muted);
  border:1px dashed color-mix(in oklab,#f0a868 45%,var(--hairline));border-radius:9px;
  padding:8px 15px;background:linear-gradient(color-mix(in oklab,#f0a868 7%,transparent),transparent);
  transition:border-color .18s var(--ease),box-shadow .22s var(--ease),background .18s
}
.surface-strip .ss-dot{width:8px;height:8px;border-radius:50%;background:#f0a868;box-shadow:0 0 8px -1px #f0a868;flex-shrink:0}
.surface-strip .ss-label{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.surface-strip .ss-label b{color:#f6bd8a;font-weight:700}
.surface-strip .ss-sep{opacity:.5;margin:0 2px}
.surface-strip .ss-tag{font-size:.55rem;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#f0a868;flex-shrink:0}
.surface-strip:hover{border-color:#f0a868;background:linear-gradient(color-mix(in oklab,#f0a868 12%,transparent),transparent)}
