---
/**
 * Shipped.astro — "the platform." · the things I build, as the FOUR-PLANE STACK.
 *
 * VOICE: builder's showcase, not vendor pitch — this is the "what I've been
 * building" chapter of a personal apex site. The storyboard is truthful
 * architecture: one surface, one control plane, one catalog, one record. The
 * planes COMPOSE UPWARD: foundation (estate, the system of record) →
 * capability (garden, the catalog) → control (crew, verified work) → the
 * EXPERIENCE capstone: one surface (wicked-studio) on one project model;
 * interactive moved to Foundation as the document engine. The CONTRACT between each pair of
 * planes is named on the seam (.stack-riser). The full product stories live
 * on the per-plane deep-dive sites each block links to. The old "build on it."
 * extension coda is folded into ONE outro line (.stack-outro) pointing at
 * garden's #extend.
 *
 * Left column = the stack (three plane layers + the experience capstone).
 * Right column = the REUSED preview pane. All four blocks are browser-frame
 * screenshots of live sites now: studio's DNS landed, so it previews as a site
 * like the rest and nothing renders the faux code-card. showLib stays wired for
 * the next product that ships without a site.
 * Selecting any block drives that pane (showSite / showLib) via data-idx +
 * data-mode + data-preview/data-lib + data-role/data-color — the same
 * contract as before.
 *
 * AUTO-PLAY (shipped.js): energy RISES up the spine — foundation → capability
 * → control — pinging each plane as it passes, then the experience capstone
 * fires (the surface lights up), holds a beat, and the pulse restarts at the
 * bottom. Any click / focus / arrow-key hands the preview to the visitor.
 * Parks fully-built under prefers-reduced-motion. Below ~880px it falls back
 * to a stacked, plane-labelled list (.shipped-mobile).
 *
 * Plane hues mirror wicked-web's tokens (--plane-*): experience amber ·
 * control violet · capability green · foundation blue. Literals here because
 * shipped.js pipes data-color into an inline --center-glow.
 *
 * Retired/absorbed products get no block: testing dissolved into garden
 * (the qe fleet) + crew (the gate); brain retired into estate (2026-08); bus/vault/
 * ledger are internal to the foundation; wicked-core is the engine inside crew.
 */

// ── the EXPERIENCE capstone: one surface, one project model ──────────────────
// Was two blocks, "two front doors". wicked-interactive is no longer one of them: it moved to
// Foundation as the document engine, has no site, and wi.wickedagile.com now redirects to
// ws.wickedagile.com. Studio is the surface, and it has its own site to preview.
const capstone = {
  // Just the plane name. It sits in the same 88px label column as CONTROL / CAPABILITY /
  // FOUNDATION, so it has to read like them. The role line it used to carry
  // ("where product work happens") stacked ABOVE the block and made this the only row in the
  // stack with two rows -- the block lined up on the same edge, but the ROW did not, and it
  // read as a different kind of element. The role is already stated in the section intro.
  label: 'Experience',
  hue: '#f0a868',
  blocks: [
    { name: 'wicked-studio', role: 'the surface', order: 3, idx: 0, mode: 'site', preview: '0', color: '#f0a868', tint: '#f6bd8a', href: 'https://ws.wickedagile.com' },
  ],
};

// ── the PLANES, TOP → BOTTOM (foundation renders last/lowest). Each block
// keeps the data-* preview contract (idx/mode/preview|lib/role/color) plus
// data-order = the bottom-up assemble sequence. `contract` = what crosses the
// seam ABOVE this plane (rendered as the riser between them).
const layers = [
  { key: 'control', label: 'Control', hue: '#d2a8ff',
    contract: 'submit intent · watch the run · answer gates',
    blocks: [
      { name: 'wicked-crew', role: 'Drive · gate · audit', order: 2, idx: 2, mode: 'site', preview: '3', color: '#d2a8ff', tint: '#e2c5ff', href: 'https://wc.wickedagile.com' },
    ]},
  { key: 'capability', label: 'Capability', hue: '#56d364',
    contract: 'invokes skills as governed workers — evaluator ≠ creator',
    blocks: [
      { name: 'wicked-garden', role: 'The catalog', order: 1, idx: 3, mode: 'site', preview: '1', color: '#56d364', tint: '#7ee787', href: 'https://wg.wickedagile.com' },
    ]},
  { key: 'foundation', label: 'Foundation', hue: '#79c0ff',
    contract: 'reads & writes the record — never around it',
    blocks: [
      { name: 'wicked-estate', role: 'System of record', order: 0, idx: 4, mode: 'site', preview: '2', color: '#79c0ff', tint: '#a5d6ff', href: 'https://we.wickedagile.com' },
    ]},
];

// ── MOBILE fallback data (article-style): the planes, top-down. ──────────────
const packages = [
  { name: 'wicked-crew', role: 'Control', color: '#d2a8ff', lang: 'JS', site: 'wc.wickedagile.com', href: 'https://wc.wickedagile.com', shot: '/screenshots/wicked-crew.png', desc: 'The control plane — intent in, verified work out. Runs your coding agents as governed workers: evaluator ≠ creator, "done" re-derived from evidence, the human in command.' },
  { name: 'wicked-studio', role: 'Experience', color: '#f0a868', lang: 'TS', site: 'ws.wickedagile.com', href: 'https://ws.wickedagile.com', shot: '/screenshots/wicked-studio.png', desc: 'Where product work happens — brainstorm it, build it under a check nothing self-approves, then produce the doc, deck or demo. Its own product; crew still bundles it.' },
  { name: 'wicked-garden', role: 'Capability', color: '#56d364', lang: 'JS', site: 'wg.wickedagile.com', href: 'https://wg.wickedagile.com', shot: '/screenshots/wicked-garden.png', desc: 'The catalog your agents act through — multi-model councils, graph-aware refactors, repo playbooks, the QE specialist fleet. Open to your own packs.' },
  { name: 'wicked-estate', role: 'Foundation', color: '#79c0ff', lang: 'RS', site: 'we.wickedagile.com', href: 'https://we.wickedagile.com', shot: '/screenshots/wicked-estate.png', desc: 'The system of record — a 102-language code graph, memory, and knowledge in one binary (MCP). Zero-infra, local-first; a team profile (self-hosted Postgres) ships for the CLI and index path — MCP under team is the named follow-up.' },
  { name: 'wicked-interactive', role: 'Foundation', color: '#79c0ff', lang: 'TS', href: 'https://github.com/mikeparcewski/wicked-interactive', desc: 'The document engine — doc storage and version lineage, HTML/PDF/PPTX rendering, demo recording. crew spawns it as a local bridge and proxies it: you depend on it, you do not visit it.' },
];
const crewPkg = packages.find((p) => p.name === 'wicked-crew');
const restPkgs = packages.filter((p) => p.name !== 'wicked-crew');
---

<!-- ════════════════════════════════════════════════════════════════
     SHIPPED — "the platform." · the FOUR-PLANE STACK.
     Planes compose UPWARD — foundation → capability → control → the experience
     capstone: one surface (wicked-studio) on one project model.
     ════════════════════════════════════════════════════════════════ -->
<section class="zoneB-section snap-section" id="projects">
  <div class="build-shell">
    <!-- compact header -->
    <div class="orbit-head">
      <span class="zone-kicker">WHAT I'VE BEEN BUILDING · FOUR PLANES · ONE SURFACE</span>
      <h2 class="zone-title">the experiment.</h2>
      <p class="orbit-caption">What I've been building: the wicked experiment — <b>a record</b> of what's true, <b>a catalog</b> agents act through, <b>a control plane</b> that verifies the work, and <b>one surface</b> on top. Local-first, zero-infra; every block links out to its own site for the full story.</p>
    </div>

    <div class="build-grid">
      <!-- ── LEFT: the four-plane stack ──────────────────────────────── -->
      <div class="stack-col">
        <div class="stack" id="stackRoot" role="group"
             aria-label="The wicked experiment, four planes: the foundation (wicked-estate, the system of record), the capability catalog (wicked-garden), the control plane (wicked-crew), and the experience plane on top — one surface, wicked-studio, on one project model.">

          <!-- the rising "energy" pulse (travels the spine, driven by shipped.js) -->
          <span class="spine-pulse" id="spinePulse" aria-hidden="true"></span>

          <!-- capstone: the EXPERIENCE plane — one surface, one project model -->
          <div class="solution-cap" id="solutionCap" style={`--hue:${capstone.hue}`}>
            <span class="cap-head">{capstone.label}</span>
            <div class="cap-blocks">
              {capstone.blocks.map((b) => (
                <a
                  class="block"
                  href={b.href}
                  target={b.mode === 'site' ? '_self' : '_blank'}
                  rel="noopener"
                  style={`--role:${b.color};--role-tint:${b.tint}`}
                  data-idx={b.idx}
                  data-mode={b.mode}
                  data-preview={b.preview}
                  data-lib={b.mode === 'lib' ? b.lib : undefined}
                  data-role={b.role}
                  data-color={b.color}
                  data-order={b.order}
                  aria-label={`${b.name} — ${b.role}`}
                >
                  <span class="blk-dot" aria-hidden="true"></span>
                  <span class="blk-name">{b.name}</span>
                  <span class="blk-role">{b.role}</span>
                </a>
              ))}
            </div>
          </div>

          <!-- the three planes below, top → bottom (foundation lowest); the
               riser between planes names the CONTRACT that crosses the seam -->
          {layers.map((layer) => (
            <>
              <div class="stack-riser" aria-hidden="true"><span class="riser-arrow">▲</span><span class="riser-word">{layer.contract}</span></div>
              <div class:list={["layer", `layer--${layer.key}`]} style={`--hue:${layer.hue}`}>
                <span class="layer-label">{layer.label}</span>
                <div class="layer-blocks">
                  {layer.blocks.map((b) => (
                    <a
                      class="block"
                      href={b.href}
                      target={b.mode === 'site' ? '_self' : '_blank'}
                      rel="noopener"
                      style={`--role:${b.color};--role-tint:${b.tint}`}
                      data-idx={b.idx}
                      data-mode={b.mode}
                      data-preview={b.preview}
                      data-lib={b.mode === 'lib' ? b.lib : undefined}
                      data-role={b.role}
                      data-color={b.color}
                      data-order={b.order}
                      aria-label={`${b.name} — ${b.role}`}
                    >
                      <span class="blk-dot" aria-hidden="true"></span>
                      <span class="blk-name">{b.name}</span>
                      <span class="blk-role">{b.role}</span>
                    </a>
                  ))}
                </div>
              </div>
            </>
          ))}
        </div>

        <p class="stack-hint">Energy rises foundation → surface · click a block to preview · arrow keys walk the stack</p>
      </div>

      <!-- ── RIGHT: the REUSED preview pane ───────────────────────────── -->
      <div class="preview-col" id="workspacePane">
        <div class="ide-preview" id="idePreview" data-mode="site">
          <div class="center-titlebar">
            <span class="ct-name" id="crumbName">wicked-estate</span>
            <span class="ct-role" id="centerRole" style="color:#79c0ff">Code graph</span>
          </div>

          <div class="preview-stage" id="previewPanel">
            <!-- MODE (a): SITE — browser-frame (shown at init; estate = foundation) -->
            <div class="browser-frame" id="browserFrame">
              <div class="browser-chrome">
                <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="url" id="previewUrl">we.wickedagile.com</span>
                <span class="live"><span class="pulse" aria-hidden="true"></span>Live</span>
              </div>
              <div class="browser-shot" id="browserShot">
                <div class="shot-bg shot-bg-back"></div>
                <div class="shot-bg shot-bg-front" style="background-image:url('/screenshots/wicked-estate.png')"></div>
              </div>
            </div>

            <!-- MODE (b): LIBRARY — faux code-editor card (hidden at init). No product
                 currently renders here: studio moved to a site preview when it got its own
                 site. Kept for the next product that ships without one. -->
            <div class="code-card" id="codeCard" aria-hidden="true" hidden>
              <div class="code-card-chrome">
                <span class="cc-glyph" aria-hidden="true">TS</span>
                <span class="cc-file" id="codeFile">wicked-studio.ts</span>
                <span class="cc-badge">read-only</span>
              </div>
              <div class="code-card-body">
                <pre class="code-block" id="codeBlock"><code></code></pre>
              </div>
            </div>
          </div>

          <div class="preview-readout">
            <div class="readout-desc" id="readoutDesc">Your live technical environment, queryable — requirements↔implementation, blast-radius, infra + policy relationships, operational history.</div>
            <a class="readout-cta" id="readoutCta" href="https://we.wickedagile.com">Open ↗</a>
          </div>
        </div>
      </div>
    </div>{/* .build-grid */}

    <!-- MOBILE (≤880): the control plane, then the rest as a plane-labelled list. -->
    <div class="shipped-mobile" aria-label="the wicked experiment — four planes, plane by plane">
      <a class="expm-feat" href={crewPkg.href} target="_self" rel="noopener" style={`--role:${crewPkg.color}`}>
        <div class="expm-feat-shot" style={crewPkg.shot ? `background-image:url('${crewPkg.shot}')` : ''}>
          <span class="expm-feat-tag">Control · the plane that verifies</span>
        </div>
        <div class="expm-feat-body">
          <h3 class="expm-feat-name">wicked-crew</h3>
          <p class="expm-feat-desc">{crewPkg.desc}</p>
          {crewPkg.site && (<span class="expm-feat-cta">{crewPkg.site} ↗</span>)}
        </div>
      </a>

      {restPkgs.map((p) => (
        <a class={`expm-row${p.shot ? ' has-shot' : ' is-repo'}`} href={p.href} target={p.shot ? '_self' : '_blank'} rel="noopener" style={`--role:${p.color}`}>
          {p.shot
            ? (<span class="expm-thumb" style={`background-image:url('${p.shot}')`}></span>)
            : (<span class="expm-thumb expm-thumb--icon"><span class="expm-glyph">{p.lang}</span></span>)}
          <span class="expm-body">
            <span class="expm-title"><b>{p.name}</b><span class="expm-role">{p.role}</span></span>
            <span class="expm-desc">{p.desc}</span>
          </span>
          <span class="expm-badge">{p.site ? 'live ↗' : 'repo ↗'}</span>
        </a>
      ))}
    </div>

    <!-- OUTRO — the folded-in extension coda (one line, links to garden's
         extend story). Replaces the retired full-band Extend section. -->
    <p class="stack-outro">Built to be built on — the catalog is open to your own packs. <a href="https://wg.wickedagile.com/#extend">extend it in the garden →</a></p>
  </div>
</section>

<style is:global>
/* ══════════════════════════════════════════════════════════════════
   SHIPPED — THE LAYERED STACK (building blocks → a solution)
   Reuses the hero editor conceit: #0d0f12 preview pane, 12px radius, deep
   shadow, var(--font-mono), the family role-colors. Theme-aware ground
   (tokens); the preview pane stays dark in both themes (matches the hero
   terminal). Left = the composing stack, right = the live preview.
   ══════════════════════════════════════════════════════════════════ */

.zoneB-section{
  border-top:1px solid var(--hairline);
  min-height:100svh;
  scroll-margin-top:var(--topbar-h);
  display:flex;flex-direction:column;justify-content:center;align-items:center;
  /* For visual centering in the visible area below the fixed topbar, the rule
     is: padding-bottom = padding-top + topbar-height. This counteracts the
     topbar offset so justify-content:center lands at the visual midpoint. */
  padding:clamp(12px,1.8vh,20px) 24px calc(var(--topbar-h) + clamp(12px,1.8vh,20px));
  overflow:hidden; /* the stack is tuned to fit one viewport, never scroll */
}
.build-shell{
  width:100%;max-width:1320px;margin:0 auto;
  display:flex;flex-direction:column;align-items:center;
  gap:clamp(14px,2.4vh,28px)
}

/* ── COMPACT HEADER ────────────────────────────────────────────── */
.orbit-head{display:flex;flex-direction:column;align-items:center;gap:clamp(5px,1vh,12px);text-align:center}
.orbit-head .zone-kicker{justify-content:center}
.orbit-head .zone-kicker::before,
.orbit-head .zone-kicker::after{content:'';width:18px;height:1px;background:var(--hairline-strong)}
.zone-title{
  font-family:var(--font-display);font-weight:900;font-stretch:125%;
  font-size:clamp(1.9rem,3.2vw,2.9rem);color:var(--ink);
  line-height:.9;letter-spacing:-.03em;margin:0
}
.orbit-caption{
  font-family:var(--font-sans,inherit);font-size:clamp(.8rem,1.1vw,.94rem);
  line-height:1.4;color:var(--muted);margin:0;max-width:64ch
}
.orbit-caption b{color:var(--ink);font-weight:700}

/* ── TWO-COLUMN: stack (left) + live preview (right) ───────────────── */
.build-grid{
  width:100%;display:grid;
  grid-template-columns:minmax(0,0.92fr) minmax(0,1.08fr);
  gap:clamp(16px,2.6vw,44px);align-items:center
}
.stack-col{display:flex;flex-direction:column;gap:clamp(8px,1.1vh,14px);min-width:0}

/* ── THE STACK ─────────────────────────────────────────────────── */
.stack{
  position:relative;display:flex;flex-direction:column;gap:clamp(5px,.8vh,9px);
  padding-left:26px; /* rail gutter: energy rises up the spine into the capstone */

  /* ROW GEOMETRY — shared by the three plane rows AND the experience capstone
     so every product block lands on ONE vertical edge. A block's left offset
     inside its row box is always: --rail-w + --row-pad-l + --label-col +
     --label-gap. The capstone has no plane label to fill that column, but it
     still reserves it (see .solution-cap) — otherwise its block sits ~95px
     left of the other three and the stack reads as broken. Change these here,
     never per-row. */
  --rail-w:2px;      /* the accent border-left that carries the plane hue */
  --row-pad-l:10px;  /* row padding inside that border */
  --label-col:88px;  /* the CONTROL / CAPABILITY / FOUNDATION label column */
  --label-gap:12px;  /* label column → blocks column */
}
/* the spine rail (energy travels UP it, foundation blue → experience amber) */
.stack::before{
  content:'';position:absolute;left:11px;top:10px;bottom:10px;width:2px;z-index:0;
  background:linear-gradient(to top,color-mix(in oklab,#79c0ff 45%,transparent),color-mix(in oklab,#f0a868 62%,transparent));
  opacity:.32;border-radius:2px
}
/* the travelling energy pulse — JS animates its `top`; hidden at rest */
.spine-pulse{
  position:absolute;left:11px;top:0;transform:translate(-50%,-50%);z-index:2;
  width:12px;height:12px;border-radius:50%;pointer-events:none;opacity:0;
  background:radial-gradient(circle,#fff,var(--accent) 42%,color-mix(in oklab,var(--accent) 45%,transparent) 66%,transparent 76%);
  box-shadow:0 0 16px 4px color-mix(in oklab,var(--accent) 55%,transparent),0 0 34px 8px color-mix(in oklab,var(--accent) 22%,transparent)
}

/* capstone — the EXPERIENCE plane (tinted in its plane hue via --hue): the
   surface lives INSIDE it, selectable like any other block.
   It mirrors .layer's grid EXACTLY, one row: the plane name in the label column,
   the product block in the second column, both vertically centred. That is what
   puts all four rows on the same two vertical edges.
   It used to put the head on a row of its own spanning both columns, with the
   block beneath. The blocks still lined up — but the capstone was a two-row grid
   among three single-row ones, so wicked-studio read as a different kind of
   element. Keep this a single row. */
.solution-cap{
  position:relative;z-index:1;
  display:grid;grid-template-columns:var(--label-col) 1fr;
  column-gap:var(--label-gap);align-items:center;  /* single row: no row-gap to give */
  padding:11px 16px 12px var(--row-pad-l);border-radius:12px;
  border:1px solid color-mix(in oklab,var(--hue,var(--accent)) 55%,var(--hairline));
  border-left-width:var(--rail-w);
  background:linear-gradient(color-mix(in oklab,var(--hue,var(--accent)) 14%,transparent),color-mix(in oklab,var(--hue,var(--accent)) 4%,transparent));
  box-shadow:0 0 0 1px color-mix(in oklab,var(--hue,var(--accent)) 12%,transparent),0 14px 40px -22px rgba(0,0,0,.7);
  transition:box-shadow .4s var(--ease),border-color .4s var(--ease),background .4s var(--ease)
}
/* column 1 — the label cell. Same typography as .layer-label so the four rows read as one
   stack; the capstone is already distinguished by its border, gradient and is-built glow, so it
   does not also need a different row shape. */
.solution-cap .cap-head{
  grid-column:1;
  font-family:var(--font-mono);font-size:.55rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;
  color:color-mix(in oklab,var(--hue,var(--accent)) 62%,var(--muted));line-height:1.25
}
/* column 2 — the SAME column the plane rows put their blocks in */
.solution-cap .cap-blocks{grid-column:2;display:flex;flex-wrap:wrap;gap:8px;min-width:0}
/* fires when the pulse reaches the top (auto-play) or on any interaction */
.solution-cap.is-built{
  border-color:var(--hue,var(--accent));
  background:linear-gradient(color-mix(in oklab,var(--hue,var(--accent)) 24%,transparent),color-mix(in oklab,var(--hue,var(--accent)) 8%,transparent));
  box-shadow:0 0 0 1px color-mix(in oklab,var(--hue,var(--accent)) 40%,transparent),0 0 46px -10px var(--hue,var(--accent)),0 14px 40px -22px rgba(0,0,0,.7)
}

/* the CONTRACT seam between two planes — what crosses it, named */
.stack-riser{
  position:relative;z-index:1;display:flex;align-items:center;gap:8px;
  padding-left:6px;margin:-1px 0 1px;
  font-family:var(--font-mono);font-size:.55rem;letter-spacing:.07em;text-transform:uppercase;color:var(--faint);line-height:1.35
}
.stack-riser .riser-arrow{color:color-mix(in oklab,var(--accent) 70%,var(--faint));font-size:.7rem;line-height:1;flex-shrink:0}
.stack-riser .riser-word{min-width:0}

/* ── LAYERS ────────────────────────────────────────────────────── */
.layer{
  position:relative;z-index:1;
  display:grid;grid-template-columns:var(--label-col) 1fr;align-items:center;gap:var(--label-gap);
  padding:8px 12px 8px var(--row-pad-l);border-radius:11px;
  border:1px solid var(--hairline);
  border-left:var(--rail-w) solid color-mix(in oklab,var(--hue) 60%,var(--hairline));
  background:linear-gradient(color-mix(in oklab,var(--hue) 5%,transparent),transparent 78%);
  transition:box-shadow .5s var(--ease),border-color .5s var(--ease),background .5s var(--ease)
}
/* the rising pulse "energizes" each layer as it passes (brief, then fades) */
.layer.is-pinged{
  border-left-color:color-mix(in oklab,var(--hue) 92%,#fff);
  background:linear-gradient(color-mix(in oklab,var(--hue) 13%,transparent),transparent 82%);
  box-shadow:-8px 0 26px -12px var(--hue),0 0 0 1px color-mix(in oklab,var(--hue) 28%,transparent)
}
.layer-label{
  font-family:var(--font-mono);font-size:.55rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;
  color:color-mix(in oklab,var(--hue) 62%,var(--muted));line-height:1.25
}
.layer-blocks{display:flex;flex-wrap:wrap;gap:8px;min-width:0}

/* a BLOCK = one package (selectable → drives the preview) */
.block{
  display:inline-flex;align-items:center;gap:8px;
  padding:7px 13px 7px 10px;border-radius:9px;text-decoration:none;
  background:linear-gradient(#14181d,#0f1216);
  border:1px solid var(--hairline-strong);
  box-shadow:0 6px 18px rgba(0,0,0,.42);
  font-family:var(--font-mono);white-space:nowrap;cursor:pointer;
