---
/**
 * CanDo.astro — "what you can do with it": eight things a person can do with
 * the platform today, right under "how it works", then one "coming soon" line
 * (no dates). Every tile is true of crew 0.16.12 / studio 0.14.0 / garden
 * 12.62.0 (release-1101): the requirements, Learn and voice tiles ship in that
 * release, so this copy deploys only after it publishes.
 *
 * The tiles reuse Story's .story-step / .story-h / .story-p boxes, so the two
 * sections share one look; this file owns only the grid and the coming line.
 */
const TILES = [
  { h: 'Fix a bug, ship a feature', p: 'Describe it; your agents build it in a sandbox and, by default, a different agent reviews it. With PR delivery on a supported remote, you get a PR with the evidence.' },
  { h: 'Ask how your code fits together', p: 'Pick the repos and ask. A read-only analysis answers and cites the files it read.' },
  { h: 'See what your code does', p: 'Generate a requirements graph for a repo and see its real coverage against your minimum (for example “80% real requirements · minimum 80%”). Placeholders never count; where corroboration is known, a requirement shows validated or unconfirmed, with the reason.' },
  { h: 'Teach it how your team works', p: 'Point Learn at your team docs and your best repos. It suggests rules and memories; you choose which become active.' },
  { h: 'Set rules, then test them', p: 'Rules apply to every repository or to one project, and can target a language, a layer or a framework. Evaluate replays good and bad examples of agent behaviour against your enforcing rules and shows what they catch, what slips through and which rules the examples never exercised.' },
  { h: 'Talk to it', p: 'With whisper.cpp installed, press the mic and say “show me this job”, then “tell it to keep the old URL working”. Nothing is sent to a job until you confirm it on screen. Speech becomes text on your machine, and the audio is never stored.' },
  { h: 'Build your own tools', p: 'Built-in jobs design, build, test and install an MCP server or a studio editor plugin; the install waits for your consent.' },
  { h: 'Draft docs, decks and pages', p: 'A built-in job writes the first draft and, by default, a different agent reviews it; you edit it in place and export documents and decks as PDF. Demo recordings come with captions (no voice-over).' },
];
---

<section class="can-section snap-section" id="can" aria-labelledby="canHeading">
  <div class="can-shell">
    <div class="story-head">
      <span class="zone-kicker">WHAT YOU CAN DO</span>
      <h2 class="zone-title" id="canHeading">what you can do with it.</h2>
    </div>
    <ul class="can-grid">
      {TILES.map((t) => (
        <li class="story-step can-tile">
          <h3 class="story-h">{t.h}</h3>
          <p class="story-p">{t.p}</p>
        </li>
      ))}
    </ul>
    <p class="can-soon"><strong>Coming soon:</strong> a catalog of job types in New job, and <strong>Apps</strong>: live apps and dashboards over your APIs and databases.</p>
  </div>
</section>

<style is:global>
.can-section{
  border-top:1px solid var(--hairline);
  scroll-margin-top:var(--topbar-h);
  display:flex;align-items:center;
  padding:calc(var(--topbar-h) + 28px) 28px 48px;
}
.can-shell{width:100%;max-width:1240px;margin:0 auto;display:flex;flex-direction:column;gap:24px}
.can-grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.can-soon{margin:0;font-size:.86rem;line-height:1.45;color:var(--muted)}
.can-soon strong{color:var(--ink)}
@media(max-width:1100px){.can-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:600px){
  .can-section{padding:40px 20px 32px}
  .can-grid{grid-template-columns:1fr}
}
</style>
