---
/**
 * Extend.astro — "build on it." · the extension pitch that closes the story.
 *
 * The platform ends on an invitation: the capability plane is a CATALOG, and
 * catalogs are meant to grow. Every claim here maps to something shipped:
 *   - garden installs as a Claude Code plugin with skills auto-discovered
 *     from the catalog;
 *   - it discovers foreign skills, MCP servers, and CLIs at runtime
 *     (integration-discovery treats third-party capability as first-class);
 *   - the naming + disclosure conventions are published (one router per
 *     domain, {vendor}-{domain}-{role} workers, three-tier disclosure);
 *   - evidence is recorded through the vault and re-derived at gates —
 *     a skill never gets to self-assert "done".
 *
 * A compact snap section (NOT full-viewport): .snap-section supplies the
 * snap-align, the unlayered min-height override below beats the @layer base
 * 100vh default so the band reads as a coda, not another full page.
 */
---

<!-- ════════════════════════════════════════════════════════════════
     EXTEND — "build on it." The catalog is open by design.
     ════════════════════════════════════════════════════════════════ -->
<section class="snap-section extend-band" id="extend" aria-labelledby="extendHeading">
  <div class="extend-inner">
    <span class="zone-kicker">EXTEND · THE CATALOG IS OPEN</span>
    <h2 class="extend-h2" id="extendHeading">build on it<span class="extend-dot">.</span></h2>
    <p class="extend-copy">
      The capability plane is a catalog, and catalogs grow. Garden ships as a plugin,
      discovers foreign skills, MCP servers, and CLIs at runtime, and publishes the
      naming contract a pack follows — <span class="extend-mono">{'{vendor}-{domain}-{role}'}</span>,
      three-tier disclosure, evidence written through the vault and never self-asserted.
      Bring your unique take: your domain rides the same governed loop, on the same record.
    </p>
    <div class="extend-ctas">
      <a class="extend-primary" href="https://wg.wickedagile.com">start in the garden →</a>
      <a class="extend-ghost" href="https://github.com/mikeparcewski/wicked-garden" target="_blank" rel="noopener">read the source ↗</a>
    </div>
  </div>
</section>

<style is:global>
/* compact coda band — unlayered so min-height beats .snap-section's 100vh */
.extend-band{
  min-height:56svh;
  display:flex;flex-direction:column;justify-content:center;
  border-top:1px solid var(--hairline);
  scroll-margin-top:var(--topbar-h);
  padding:clamp(48px,9vh,96px) 28px;
}
.extend-inner{max-width:1240px;margin:0 auto;width:100%;display:flex;flex-direction:column;gap:18px}
.extend-band .zone-kicker{display:inline-flex;align-items:center;gap:10px}
.extend-band .zone-kicker::before{content:'';width:26px;height:1px;background:var(--accent)}
.extend-h2{
  font-family:var(--font-display);font-weight:900;font-stretch:125%;
  font-size:clamp(2.4rem,5vw,4.2rem);line-height:.9;letter-spacing:-.035em;
  color:var(--ink);margin:0
}
.extend-dot{color:var(--accent)}
.extend-copy{
  max-width:68ch;font-size:clamp(1rem,1.3vw,1.16rem);line-height:1.7;color:var(--muted)
}
.extend-mono{font-family:var(--font-mono);font-size:.88em;color:var(--ink);background:color-mix(in oklab,var(--ink) 8%,transparent);border-radius:5px;padding:1px 7px;white-space:nowrap}
.extend-ctas{display:flex;gap:12px;flex-wrap:wrap;margin-top:6px}
.extend-primary{
  display:inline-flex;align-items:center;
  font-family:var(--font-mono);font-size:.72rem;font-weight:700;letter-spacing:.06em;
  padding:11px 22px;border-radius:7px;background:var(--accent);color:#0d0f12;
  text-decoration:none;transition:opacity .15s;white-space:nowrap
}
.extend-primary:hover{opacity:.84}
.extend-ghost{
  display:inline-flex;align-items:center;
  font-family:var(--font-mono);font-size:.72rem;font-weight:600;letter-spacing:.06em;
  padding:11px 22px;border-radius:7px;border:1px solid var(--hairline-strong);color:var(--ink);
  text-decoration:none;transition:border-color .18s,color .18s;white-space:nowrap
}
.extend-ghost:hover{border-color:color-mix(in oklab,var(--accent) 50%,transparent);color:var(--accent)}
@media(max-width:600px){
  .extend-band{min-height:auto;padding:44px 20px}
}
</style>
