---
/**
 * Story.astro — "how it works": the platform's core story in five steps, right
 * under the hero. Plain words only (job, agent, sandbox, rules); every step is
 * true of crew 0.16.12 / studio 0.14.0 (step 05's proposed learnings ship in
 * that release, so this copy deploys only after it publishes). Keep it in step
 * with wicked-web's family manifest and the product sites.
 */
const STEPS = [
  { n: '01', h: 'Ask in a chat', p: 'Start a job in studio with a chat. It proposes a plan, and nothing starts until you confirm it. Or pick a built-in kind of job, such as a bug fix, a feature, a migration, an MCP server or an editor plugin.' },
  { n: '02', h: 'Your agents, sandboxed', p: 'Claude Code, Codex, GitHub Copilot, OpenCode or Pi, signed in once on the Agents page, each work in a sandbox that sees your repo and has one way out: the model gateway. Your keys stay in a broker and the sandbox sees placeholders. A Claude subscription’s sign-in token is the one exception, and a guard keeps it out of the delivered work. You need a container runtime (Docker, Podman, Rancher Desktop, Colima or OrbStack).' },
  { n: '03', h: 'One builds, another checks', p: 'When you launch a preset or a plan on a repository, power mode is on by default: the code-writing step runs as one agent’s checkpointed turns, with rigor re-scored from the diff (chat runs and phase-based workflows run phased). By default a different agent reviews it against your rules. In power mode a failed review or a qualifying build-check failure goes back to the builder, up to three hand-off attempts in all; problems that need your judgment, such as a failing base or a check that times out, pause for you. A phased job retries, escalates or stops. When no other agent can review, the job stops unless you launch it as “reduced assurance”, which is labelled on the job, every gate and the delivery. A saved workflow may require fewer checks; its requirements are listed in the receipts.' },
  { n: '04', h: 'Tested before delivery', p: 'Jobs launched as a feature, bug fix, migration, MCP server or editor plugin pass acceptance testing before anything is delivered. A change small on every measure is waived, and skipping takes a reason; either is labelled. A plan you compose yourself, a build continued from a chat, or a saved workflow that does not ask for it, requires none.' },
  { n: '05', h: 'You get the evidence', p: 'The change arrives with who built it, who checked it, what ran and what was skipped. A job can propose what it learned, and you approve what becomes memory.' },
];
---

<section class="story-section snap-section" id="how" aria-labelledby="storyHeading">
  <div class="story-shell">
    <div class="story-head">
      <span class="zone-kicker">HOW IT WORKS · FIVE STEPS</span>
      <h2 class="zone-title" id="storyHeading">intent in. checked work out.</h2>
    </div>
    <ol class="story-steps">
      {STEPS.map((s) => (
        <li class="story-step">
          <span class="story-n" aria-hidden="true">{s.n}</span>
          <h3 class="story-h">{s.h}</h3>
          <p class="story-p">{s.p}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style is:global>
.story-section{
  border-top:1px solid var(--hairline);
  scroll-margin-top:var(--topbar-h);
  display:flex;align-items:center;
  padding:calc(var(--topbar-h) + 28px) 28px 48px;
}
.story-shell{width:100%;max-width:1240px;margin:0 auto;display:flex;flex-direction:column;gap:28px}
.story-head{display:flex;flex-direction:column;gap:10px}
.story-steps{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(5,1fr);gap:14px;counter-reset:none}
.story-step{
  background:color-mix(in oklab,var(--canvas-2) 88%,transparent);
  border:1px solid var(--hairline);border-radius:10px;padding:18px 16px 20px;
  display:flex;flex-direction:column;gap:8px
}
.story-n{font-family:var(--font-mono);font-size:.66rem;letter-spacing:.2em;color:var(--accent);font-weight:700}
.story-h{margin:0;font-family:var(--font-display);font-weight:800;font-stretch:110%;font-size:1.02rem;line-height:1.15;color:var(--ink)}
.story-p{margin:0;font-size:.86rem;line-height:1.45;color:var(--muted)}
@media(max-width:1100px){.story-steps{grid-template-columns:repeat(2,1fr)}}
@media(max-width:600px){
  .story-section{padding:40px 20px 32px}
  .story-steps{grid-template-columns:1fr}
}
</style>
