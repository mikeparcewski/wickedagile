---
/**
 * index.astro — the wickedagile.com landing page: the owner's PERSONAL APEX.
 * The story is the person who writes and builds — hero (builder/writer voice)
 * → the things I build (the four-plane stack) → the things I publish (the
 * dispatch feed) → a little about me (the chapters). The product SELLING
 * lives on the per-product deep-dive sites (wc/we/wg/wi/ws), not here.
 * Articles are fetched at BUILD TIME and baked in (no client-side RSS).
 */
import Base from 'wicked-web/layouts/Base.astro';
import '../styles/global.css';
import Topbar from 'wicked-web/components/Topbar.astro';
import Hero from '../components/Hero.astro';
import Articles from '../components/Articles.astro';
import Shipped from '../components/Shipped.astro';
import About from '../components/About.astro';
import Footer from 'wicked-web/components/Footer.astro';
import { getArticles } from '../lib/articles.mjs';

const articles = await getArticles();
// Bake for the hero terminal's /articles command. Escape "<" so a title can
// never break out of the inline <script>.
const articlesJson = JSON.stringify(articles).replace(/</g, '\\u003c');
---

<Base
  title="wickedagile — the best code tells a story"
  description="Mike Parcewski's body of work — the wicked platform he builds (four planes of local-first, AI-native infrastructure for coding agents), the dispatches he writes, and a little about the person behind both."
>
  <script is:inline set:html={`window.__ARTICLES__=${articlesJson};`}></script>
  <Topbar repo="https://github.com/mikeparcewski" />
  <Hero />
  <Shipped />
  <Articles articles={articles} />
  <About />
  <Footer repo="https://github.com/mikeparcewski" />
  <script>
    // Wheel streamliner — agile-specific (its section classes match the
    // selectors). NOT in the shared Base: on sites whose sections don't match,
    // it mis-computes snap points and runs the page to the bottom.
    import 'wicked-web/scripts/scroll-wheel.js';
  </script>
</Base>
