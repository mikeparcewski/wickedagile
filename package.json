{
  "name": "wickedagile",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "graph": "node scripts/build-graph.mjs",
    "graph:selftest": "node scripts/build-graph.mjs --selftest",
    "predev": "node scripts/build-graph.mjs",
    "dev": "astro dev",
    "build": "node scripts/build-graph.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test:e2e": "playwright test",
    "build:renamed": "node scripts/build-graph.mjs --door-work=Build && astro build --outDir dist-renamed && node scripts/build-graph.mjs"
  },
  "dependencies": {
    "astro": "^7.4.5",
    "wicked-web": "github:mikeparcewski/wicked-web#9b73714d63778ab54cef667ab5639a8636695b99"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
